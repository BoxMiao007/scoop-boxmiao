{
    "version": "0.1.60",
    "description": "免费的全功能 Photoshop 替代品，支持 PSD/PSB、RAW 处理与本地 AI 功能",
    "homepage": "https://tenzen.studio/photon/",
    "license": "Proprietary",
    "architecture": {
        "64bit": {
            "url": "https://downloads.tenzen.studio/photon/stable/win32/0.1.60/Photon-Studio-0.1.60-win-x64.exe#/dl.7z",
            "hash": "a3e65da73fbe2d0041fc1aea6b7f005714623cec4b800468b61d0df9199a2feb"
        },
        "arm64": {
            "url": "https://downloads.tenzen.studio/photon/stable/win32/0.1.60/Photon-Studio-0.1.60-win-arm64.exe#/dl.7z",
            "hash": "729d44bf8f0a2be37645a0f6dc848c7e8d82eebe14b5c12a82bc918b8a69dffb"
        }
    },
    "installer": {
        "script": [
            "Get-Item -Path \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
            "Remove-Item -Path \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force"
        ]
    },
    "post_install": [
        "# 关掉内置更新，避免和 Scoop 的版本管理冲突",
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "if (Test-Path $yaml) {",
        "    $content = Get-Content -Path $yaml | ForEach-Object {",
        "        if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "    }",
        "    Set-Content $yaml -Value $content -Encoding ascii",
        "}"
    ],
    "shortcuts": [
        [
            "Photon Studio.exe",
            "Photon Studio"
        ]
    ],
    "checkver": {
        "url": "https://tenzen.studio/api/v1/photon/releases/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.tenzen.studio/photon/stable/win32/$version/Photon-Studio-$version-win-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://downloads.tenzen.studio/photon/stable/win32/$version/Photon-Studio-$version-win-arm64.exe#/dl.7z"
            }
        }
    }
}
