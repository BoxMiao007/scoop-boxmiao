{
    "version": "3.16.0",
    "description": "A cross-platform desktop All-in-One assistant for Claude Code, Codex, OpenCode, OpenClaw, Gemini CLI & Hermes Agent",
    "homepage": "https://ccswitch.io",
    "license": "MIT",
    "url": "https://github.com/farion1231/cc-switch/releases/download/v3.16.0/CC-Switch-v3.16.0-Windows.msi",
    "hash": "f81d4b16c629e824f9967be5b4b8bbea8b8d5937b3fbb0a74e91d03e4ee1c5e9",
    "notes": "数据目录已持久化到 Scoop persist 目录，通过 Junction 链接到 %USERPROFILE%\\.cc-switch。官方网站: https://ccswitch.io",
    "installer": {
        "script": [
            "Move-Item \"$dir\\Programs\\CC Switch\\*\" \"$dir\" -Force",
            "Remove-Item \"$dir\\Programs\" -Recurse -Force"
        ]
    },
    "pre_install": [
        "$target = $persist_dir",
        "$link = \"$env:USERPROFILE\\.cc-switch\"",
        "if (Test-Path $link) {",
        "    $item = Get-Item $link -Force",
        "    if ($item.LinkType -eq 'Junction' -and $item.Target -eq $target) {",
        "        Write-Host 'Junction 已存在，跳过'",
        "    } else {",
        "        error '~/.cc-switch 已存在且不是指向 persist 目录的链接。请手动删除后再试。'",
        "        exit 1",
        "    }",
        "} else {",
        "    New-Item -Type Directory -Path $target -Force | Out-Null",
        "    New-Item -Type Junction -Path $link -Target $target -Force | Out-Null",
        "}",
        "if (!(Test-Path \"$target\\cc-switch.db\")) {",
        "    New-Item -Type Directory -Path \"$target\\backups\" -Force | Out-Null",
        "    New-Item -Type Directory -Path \"$target\\skill-backups\" -Force | Out-Null",
        "}"
    ],
    "uninstaller": {
        "script": [
            "$link = \"$env:USERPROFILE\\.cc-switch\"",
            "if (Test-Path $link) {",
            "    $item = Get-Item $link -Force",
            "    if ($item.LinkType -eq 'Junction') {",
            "        Remove-Item $link -Force",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/farion1231/cc-switch",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/farion1231/cc-switch/releases/download/v$version/CC-Switch-v$version-Windows.msi"
    }
}
