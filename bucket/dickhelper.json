{
    "version": "2.0.8",
    "description": "简洁易用的健康管理工具",
    "homepage": "https://github.com/zzzdajb/DickHelper",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zzzdajb/DickHelper/releases/download/desktop-v2.0.8/DickHelper-2.0.8-windows-x64.exe#/dl.7z",
            "hash": "57a2734ab94cae6c0f0f9a74a82ca7ece476e6c250709891601b59852586da2c",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -Force -ErrorAction SilentlyContinue"
            ]
        }
    },
    "post_install": [
        "# 将 AppData 中的数据目录重定向到 Scoop persist",
        "$appdataDir = \"$env:APPDATA\\dickhelper\"",
        "if (-not (Test-Path $persist_dir)) { New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null }",
        "if (Test-Path $appdataDir) {",
        "    $item = Get-Item $appdataDir -Force",
        "    if ($item.LinkType -ne 'Junction') {",
        "        Get-ChildItem $appdataDir | Move-Item -Destination $persist_dir -Force",
        "        Remove-Item $appdataDir -Recurse -Force",
        "    } else { Remove-Item $appdataDir -Force }",
        "}",
        "New-Item -ItemType Junction -Path $appdataDir -Target $persist_dir | Out-Null",
        "# 在应用目录创建快捷链接，方便跳转",
        "New-Item -ItemType Junction -Path \"$dir\\User Data\" -Target $persist_dir -Force | Out-Null"
    ],
    "pre_uninstall": [
        "$appdataDir = \"$env:APPDATA\\dickhelper\"",
        "if ((Get-Item $appdataDir -Force -ErrorAction SilentlyContinue).LinkType -eq 'Junction') {",
        "    Remove-Item $appdataDir -Force",
        "}"
    ],
    "shortcuts": [
        [
            "DickHelper.exe",
            "DickHelper"
        ]
    ],
    "checkver": {
        "github": "https://github.com/zzzdajb/DickHelper",
        "regex": "desktop-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zzzdajb/DickHelper/releases/download/desktop-v$version/DickHelper-$version-windows-x64.exe#/dl.7z"
            }
        }
    }
}
