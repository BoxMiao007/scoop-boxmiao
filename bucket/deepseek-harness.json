{
    "version": "0.2.1-rc.2",
    "description": "DeepSeek 开源的 Agent 桌面应用（预览版），基于 Cordis「一切皆插件」架构",
    "homepage": "https://www.deepseek.com/harness/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-0.2.1-rc.2-win-x64.exe#/dl.7z",
            "hash": "sha512:dfd3ce979a2c97d3ca32aacf5d0039d9d87f6c2574674daf395f5c4e33890c713a82c270a796efee57e00779955802aca57edaff0d624e2fbc2e2b2d761ab8e6"
        }
    },
    "installer": {
        "script": [
            "Get-Item -Path \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
            "Remove-Item -Path \"$dir\\`$PLUGINSDIR\", \"$dir\\Uninstall*\" -Recurse -Force"
        ]
    },
    "post_install": [
        "$yaml = \"$dir\\resources\\app-update.yml\"",
        "if (Test-Path $yaml) {",
        "    $content = Get-Content -Path $yaml | ForEach-Object {",
        "        if ($_.StartsWith('url')) { \"$($_.Replace('url', '# url')) # Disabled by Scoop\" } else { $_ }",
        "    }",
        "    Set-Content $yaml -Value $content -Encoding ascii",
        "}"
    ],
    "shortcuts": [
        [
            "DeepSeek Harness.exe",
            "DeepSeek Harness"
        ]
    ],
    "checkver": {
        "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
        "regex": "version:\\s*(?<version>\\S+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.deepseek.com/dsh-desk/bin/win-x64/deepseek-harness-$version-win-x64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://download.deepseek.com/dsh-desk/feeds/win-x64/nightly.yml",
            "regex": "(?m)^sha512:\\s*>-\\s*\\r?\\n\\s*$base64"
        }
    }
}
